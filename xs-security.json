{
  "xsappname": "animal-adoption-tracker",
  "tenant-mode": "dedicated",
  "scopes": [
    {
      "name": "$XSAPPNAME.Admin",
      "description": "Shelter administrator"
    },
    {
      "name": "$XSAPPNAME.User",
      "description": "Adopter"
    }
  ],
  "attributes": [],
  "role-templates": [
    {
      "name": "Admin",
      "description": "Shelter administrator",
      "scope-references": [
        "$XSAPPNAME.Admin"
      ],
      "attribute-references": []
    },
    {
      "name": "User",
      "description": "Adopter",
      "scope-references": [
        "$XSAPPNAME.User"
      ],
      "attribute-references": []
    }
  ],
  "role-collections": [
    {
      "name": "AAT_Admin",
      "description": "Animal Adoption Tracker administrators",
      "role-template-references": [
        "$XSAPPNAME.Admin"
      ]
    },
    {
      "name": "AAT_User",
      "description": "Animal Adoption Tracker adopters",
      "role-template-references": [
        "$XSAPPNAME.User"
      ]
    }
  ],
  "oauth2-configuration": {
    "redirect-uris": [
      "https://*.cfapps.us10-001.hana.ondemand.com/**",
      "https://*.hana.ondemand.com/**"
    ]
  }
